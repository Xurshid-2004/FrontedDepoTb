# =====================================================================
# TB tizimi — PRODUCTION muhit oʻzgaruvchilari
#
# Serverda shu faylni `.env.production` nomi bilan nusxalang va
# toʻldiring, soʻng:
#
#     docker compose --env-file .env.production up -d --build
#
# DIQQAT: .env.production'ni git'ga qoʻshmang.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Domen
# ---------------------------------------------------------------------
# Domen bor boʻlsa — HTTPS avtomatik olinadi (Let's Encrypt).
# Hali yoʻq boʻlsa `:80` qoldiring va IP orqali kiring.
TB_DOMAIN=tb.example.uz

# Brauzer koʻradigan manzil (QR havolalari shu asosda quriladi)
NEXT_PUBLIC_BASE_URL=https://tb.example.uz

# ---------------------------------------------------------------------
# 2. Maʼlumotlar bazasi
# ---------------------------------------------------------------------
POSTGRES_DB=tb
POSTGRES_USER=tb
# Kuchli parol qoʻying. Yaratish: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# 3. Django maxfiy kalitlari  (MAJBURIY)
# ---------------------------------------------------------------------
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
JWT_SECRET=

JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=30

# Domeningiz. Vergul bilan bir nechta yozish mumkin.
DJANGO_ALLOWED_HOSTS=tb.example.uz

# Frontend va backend bitta domendan ishlaydi (Caddy proxy qiladi),
# shuning uchun CORS odatda kerak emas — boʻsh qoldiring.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://tb.example.uz

# ---------------------------------------------------------------------
# 4. Frontend (build vaqtida bundle'ga qotiriladi)
# ---------------------------------------------------------------------
# Boʻsh = shu domendan (/api/v1/...). Caddy Django'ga yoʻnaltiradi.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_DEPO_KOD=TCH-6

# Demo hisob tugmalari. Productionda 0 boʻlishi SHART.
NEXT_PUBLIC_DEMO=0

# ---------------------------------------------------------------------
# 5. QR imzo kalitlari (ECDSA P-256, base64 PEM)
# ---------------------------------------------------------------------
# Yaratish:
#   openssl ecparam -genkey -name prime256v1 -noout -out ec-priv.pem
#   openssl ec -in ec-priv.pem -pubout -out ec-pub.pem
#   base64 -w0 ec-priv.pem  &&  base64 -w0 ec-pub.pem
SIGN_PRIVATE_KEY=
SIGN_PUBLIC_KEY=

# ---------------------------------------------------------------------
# 6. FaceID (ixtiyoriy — `--profile face` bilan ishga tushadi)
# ---------------------------------------------------------------------
FACE_SERVICE_TOKEN=

# ---------------------------------------------------------------------
# 7. Boshqa
# ---------------------------------------------------------------------
TZ=Asia/Tashkent

# Birinchi koʻtarilishda normativ maʼlumot (28 lavozim, 19 buyum,
# 143 norma) yoziladi. Keyin 0 ga oʻzgartirsangiz ham boʻladi —
# buyruq baribir mavjud yozuvlarni takrorlamaydi.
TB_SEED=1

# Kirish urinishlari cheklovi
THROTTLE_LOGIN=20/min
THROTTLE_WRITE=240/min
